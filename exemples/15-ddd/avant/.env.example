APP_ENV=dev
APP_SECRET=changeme_secret_key_here
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

###> Base de données
# MySQL (Docker) — utilisé par défaut
DATABASE_URL="mysql://app:app@mysql:3306/boutique_ddd?serverVersion=8.0&charset=utf8mb4"

# SQLite — pratique sans Docker
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/boutique.db"
###< Base de données

###> Mailer
# Mailpit (Docker) intercepte tous les emails en dev
MAILER_DSN=smtp://mailpit:1025

# Pour tester sans Docker (symfony CLI + mailpit local)
# MAILER_DSN=smtp://localhost:1025
###< Mailer

###> Messenger
# Transport Doctrine : les messages sont stockés en BDD
MESSENGER_TRANSPORT_DSN=doctrine://default
###< Messenger
